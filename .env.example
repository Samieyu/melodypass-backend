# Database connection string (Neon free tier PostgreSQL or local Postgres)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/melodypass?sslmode=require"

# JWT Secrets for Admin Dashboard
JWT_SECRET="super-secret-jwt-key-change-this-in-production-32-chars-minimum"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-this-in-production"

# Cloudflare R2 Bucket Details (S3 compatible)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="melodypass-audio"
R2_PUBLIC_URL_PREFIX="" # Optional fallback prefix if bucket is public

# CORS Configuration
FRONTEND_URL="http://localhost:3000"

# Application Settings
PORT=4000
NODE_ENV="development"
